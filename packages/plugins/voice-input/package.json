{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode/plugin-voice-input",
  "version": "0.1.0",
  "description": "Live voice input for the OpenCode composer, transcribed locally with MLX on Apple Silicon",
  "type": "module",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/opencode.git",
    "directory": "packages/plugins/voice-input"
  },
  "exports": {
    ".": "./index.ts",
    "./server": "./index.ts",
    "./rpc": "./rpc.ts",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "index.ts",
    "rpc.ts",
    "worker.ts",
    "worker.py",
    "dist"
  ],
  "scripts": {
    "build": "bun --bun vite build",
    "test": "bun test",
    "typecheck": "bun check --no-script",
    "typecheck:tsc": "tsc --noEmit"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.0.27 || ^0.0.0-dev"
  },
  "devDependencies": {
    "@opencode/plugin": "workspace:*",
    "@tsconfig/bun": "1.0.9",
    "@types/bun": "1.4.3",
    "@typescript/native": "npm:typescript@7.1.0-beta",
    "effect": "catalog:",
    "solid-js": "catalog:",
    "vite": "8.2.4",
    "vite-plugin-solid": "2.11.14"
  }
}
